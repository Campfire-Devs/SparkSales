# Copy these settings into local user-secrets or environment variables.
# Do not put real credentials in this file.
ConnectionStrings__DefaultConnection=<your-postgresql-connection-string>
Frontend__BaseUrl=http://localhost:5173

Jwt__Key=<generate-a-private-signing-key>
Jwt__Issuer=SparkSalesApi
Jwt__Audience=SparkSalesClient

Email__SenderAppPassword=<your-smtp-app-password>
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SenderEmail=<your-sender-email>
Email__SenderName=SparkSales
# Optional; defaults to Email__SenderEmail.
Email__DeletionRequestRecipient=<your-support-email>
